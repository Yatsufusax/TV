<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/player"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        app:resize_mode="fit"
        app:show_buffering="when_playing"
        app:use_controller="false" />

    <!-- Cartel del canal (arriba a la izquierda) -->
    <LinearLayout
        android:id="@+id/osd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_margin="32dp"
        android:background="#B3000000"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="12dp"
        android:paddingEnd="24dp"
        android:paddingBottom="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/osdNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFD54F"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/osdName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:textColor="#FFFFFF"
                android:textSize="30sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/osdGroup"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B0BEC5"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Número que se está tipeando (arriba a la derecha) -->
    <TextView
        android:id="@+id/digits"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_margin="32dp"
        android:background="#B3000000"
        android:paddingStart="24dp"
        android:paddingTop="10dp"
        android:paddingEnd="24dp"
        android:paddingBottom="10dp"
        android:textColor="#FFD54F"
        android:textSize="48sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Mensajes (abajo al centro) -->
    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="56dp"
        android:background="#CCB71C1C"
        android:gravity="center"
        android:paddingStart="28dp"
        android:paddingTop="14dp"
        android:paddingEnd="28dp"
        android:paddingBottom="14dp"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:visibility="gone" />

    <!-- Lista de canales (panel izquierdo) -->
    <ListView
        android:id="@+id/channelList"
        android:layout_width="480dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#F2101418"
        android:divider="#22FFFFFF"
        android:dividerHeight="1dp"
        android:focusable="true"
        android:listSelector="#55FFFFFF"
        android:visibility="gone" />
</FrameLayout>
